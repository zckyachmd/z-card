# Optional services are disabled when empty. Never commit real secrets.
# Client analytics ID is read at BUILD time; consent is still required.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# SMTP runtime configuration: all four are required for delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM_EMAIL=
SMTP_TO_EMAIL=
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_REJECT_UNAUTHORIZED=true

# Optional bot protection: configure both keys together.
CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=

RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_MS=60000
ROBOT_MIN_SUBMISSION_TIME=2000
NEXT_TELEMETRY_DISABLED=1
# Set DOCKER_BUILD=true only when standalone output is needed.
# CONTENT_DIRECTORY is reserved for isolated test fixture builds.
